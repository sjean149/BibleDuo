# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL on Supabase. In your project click "Connect" and copy the
# "Transaction pooler" URI (port 6543). Replace YOUR_PASSWORD with your database
# password (letters and numbers only, no square brackets).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Used to sign your own session tokens after Google sign-in. Any long random string.
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google Sign-In: OAuth 2.0 Web client ID from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Cloud service account key (used by Translation). Path is relative to the backend folder.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Websites allowed to call the API from a browser, comma separated (your deployed web app).
# Leave as * during development.
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://bibleduo.vercel.app

# Most characters per day (all visitors together) sent to Google Translate. Each visitor is
# also limited to 30 translations per 10 minutes. Both reset when the server restarts.
TRANSLATE_DAILY_CHAR_CAP=16000

# Supabase Storage, used by `python -m app.import_audio` to list the audio bucket.
# The key is in the Supabase dashboard: Project Settings > API Keys > secret (or service_role).
# It can read and change everything in your project, so keep it in .env only (never in the app).
SUPABASE_URL=https://phyciutjfkuekcqsqbyf.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-secret-key

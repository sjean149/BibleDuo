# Copy this file to .env (same folder) for a deployed build. Never put secrets here:
# everything starting with EXPO_PUBLIC_ is copied into the app and anyone can read it.

# Your deployed backend, without a trailing slash. Leave unset during development.
EXPO_PUBLIC_API_URL=https://your-api.onrender.com

# Google sign-in: OAuth client ids from Google Cloud Console > APIs & Services > Credentials.
# The web id must match GOOGLE_CLIENT_ID in backend/.env. iOS / Android ids are only needed for
# installed builds (add them to the backend's GOOGLE_CLIENT_ID list too, comma separated).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# true = visitors get unlimited hearts, so nobody demoing the app gets locked out.
EXPO_PUBLIC_DEMO_MODE=true

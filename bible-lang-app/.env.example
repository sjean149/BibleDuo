# Copy this file to .env (same folder) for a deployed build. Never put secrets here:
# everything starting with EXPO_PUBLIC_ is copied into the app and anyone can read it.

# Your deployed backend, without a trailing slash. Leave unset during development.
EXPO_PUBLIC_API_URL=https://your-api.onrender.com

# true = visitors get unlimited hearts, so nobody demoing the app gets locked out.
EXPO_PUBLIC_DEMO_MODE=true
